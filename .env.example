# ===== 电动车不安全使用行为识别系统 环境配置 =====
# 复制为 .env 后按需修改；生产环境务必修改 SECRET_KEY
# 外部服务（OSS / 高德 / 短信 / HTTPS）的获取与配置步骤见 docs/外部服务接入指南.md

APP_NAME=电动车不安全使用行为识别系统
DEBUG=true

# --- 安全 ---
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(36))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 管理端初始账号密码（仅 scripts/init_db.py 首次创建账号时生效） ---
# 留空 = 初始化时随机生成强密码并打印一次；已存在的账号不会被覆盖。
# 修改既有账号密码用：python scripts/set_password.py --username admin --generate
# 注意：不要把生产密码提交进仓库。
SEED_ADMIN_PASSWORD=
SEED_REVIEWER1_PASSWORD=
SEED_REVIEWER2_PASSWORD=

# --- 数据库（SQLite；迁移 PostgreSQL 时改为 postgresql+psycopg://user:pwd@host/db） ---
DATABASE_URL=sqlite:///./data/ev_audit.db
AUTO_CREATE_TABLES=true

# ============================================================
# 一、图片存储：local（本地磁盘，默认）| oss（阿里云对象存储）
# ============================================================
STORAGE_BACKEND=local
DATA_DIR=./data
IMAGES_DIR=./data/images
# 切换 OSS 时填写下列 4 项，并把 STORAGE_BACKEND 改为 oss
# 获取路径：阿里云控制台 → 对象存储 OSS → Bucket → 概览（Endpoint）；访问控制 → RAM 用户
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ============================================================
# 二、短信：mock（开发模拟，默认）| aliyun_dypns（个人实名即可开通）| aliyun（需企业资质）
#   mock          不真实发送，验证码写日志并由接口回显，仅开发用
#   aliyun_dypns  阿里云「短信认证」服务（号码认证服务）——用控制台赠送的签名+模板，
#                 不需要企业营业执照、不需要申请签名与运营商报备；**仅支持验证码**
#   aliyun        阿里云「短信服务」——需企业/事业单位资质并自建签名、模板；支持验证码 + 通知
# ============================================================
SMS_PROVIDER=mock
# Mock 通道固定验证码（仅开发环境使用）
SMS_MOCK_CODE=888888
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
# 切换到 aliyun_dypns / aliyun 时填写下列各项
# aliyun_dypns 获取路径：阿里云控制台 → 号码认证服务 → 短信认证 →「赠送签名配置」「赠送模板配置」
#                        AccessKey 建议用 RAM 子账号，仅授权 dypns:SendSmsVerifyCode
# aliyun       获取路径：阿里云控制台 → 短信服务 → 签名管理 / 模板管理
#                        AccessKey 建议用 RAM 子账号，仅授权 dysms:SendSms
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 模板里的验证码变量名（赠送模板通常就是 code；若模板含 ${min} 之类变量，用下一行补固定值）
SMS_TEMPLATE_PARAM_NAME=code
SMS_TEMPLATE_EXTRA_JSON={}
# 以下两项仅 aliyun_dypns 使用：验证码有效期 / 同号发送间隔（秒）
SMS_DYPNS_VALID_TIME_SECONDS=300
SMS_DYPNS_INTERVAL_SECONDS=60
# 仅 aliyun（企业通道）支持通知短信；dypns 通道下留空即可，通知自动降级为站内信
SMS_NOTICE_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou

# ============================================================
# 三、逆地理编码：stub（默认，不外呼）| amap（高德）
# ============================================================
GEOCODING_PROVIDER=stub
# 获取路径：高德开放平台 → 控制台 → 应用管理 → 创建应用 → 添加 Key（服务平台选「Web服务」）
AMAP_KEY=

# ============================================================
# 四、AI 审核：rule（规则占位引擎，默认）| qwenvl（视觉大模型）
# 接入步骤：跑 scripts/enable_ai.py --key sk-xxxx（自动写入并真实探测）；
# 或手动填下方 Key 后把 AI_PROVIDER 改为 qwenvl（改完必须重启服务）。
# 个人实名即可开通，选型与成本见 docs/外部服务接入指南.md 第五节
# ============================================================
AI_PROVIDER=rule
# 获取路径：阿里云百炼控制台 → 模型服务 → API-KEY 管理（sk- 开头）
DASHSCOPE_API_KEY=
# 视觉模型与接口（默认即可；想更省换 qwen3-vl-flash，想更强换 qwen-vl-max）
AI_VL_MODEL=qwen3-vl-plus
AI_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次审核参数：超时秒数 / 最多送几张图 / 送模型前图片最长边 / JPEG 质量
AI_VL_TIMEOUT_SECONDS=60
AI_VL_MAX_IMAGES=9
AI_VL_MAX_EDGE=1024
AI_VL_JPEG_QUALITY=82

# --- 上传限制 ---
MAX_IMAGES_PER_REPORT=9
MAX_IMAGE_MB=15
ORIGIN_MAX_EDGE=2048
THUMB_MAX_EDGE=320
IMAGE_JPEG_QUALITY=85

# --- 图片访问签名有效期（秒） ---
IMAGE_URL_TTL_SECONDS=600

# --- CORS（生产建议改为你的域名，例如 https://ebikeguard.xyz） ---
CORS_ORIGINS=*

# ============================================================
# 五、部署参数（仅服务器端生效，本地 run.py 不读）
# ============================================================
# Gunicorn worker 数。不设时按 deploy/gunicorn/gunicorn.conf.py 的公式 max(2, min(4, CPU 核数))。
# 1 GiB 内存的机器（如阿里云免费试用档）建议显式设为 1，避免 Pillow 解码大图时内存不足。
# GUNICORN_WORKERS=1

# ============================================================
# 六、通知通道（邮件 SMTP + 群机器人 Webhook；详见 docs/外部服务接入指南.md「通知通道」节）
# ============================================================
# 通道默认开启、配置就绪即生效；也可在管理后台「系统配置」里逐项关闭（notify.* 键）。
# 一键启用（写入 .env + 真实发送探测 + 失败自动回滚）：
#   .\.venv\Scripts\python.exe scripts\enable_notify.py --mode email --smtp-host smtp.189.cn --smtp-user you@189.cn --smtp-pass 授权码 --to 收件人@example.com
#   .\.venv\Scripts\python.exe scripts\enable_notify.py --mode webhook --webhook-kind wecom --webhook-url "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"

# --- 邮件通道：EMAIL_PROVIDER=mock（默认，未启用）| smtp ---
# 授权码获取：189 邮箱 → 设置 → 客户端设置；QQ 邮箱 → 设置 → 账户 → 开启 POP3/SMTP → 生成授权码
# 端口必须用 465（SSL）或 587（STARTTLS）——阿里云服务器出站 25 端口被封装
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 内部运营提醒（新工单待审 / SLA 超时等）的收件邮箱，可选、逗号分隔
NOTIFY_OPS_EMAIL=

# --- 群机器人通道：WEBHOOK_KIND=wecom（企业微信）| dingtalk（钉钉） ---
# 地址获取：企业微信群 → 群设置 → 群机器人 → 添加；钉钉群 → 群设置 → 智能群助手
# 机器人若设置了「自定义关键词」安全策略，关键词需包含消息中会出现的词（如「上报」）
WEBHOOK_KIND=wecom
WEBHOOK_URL=
